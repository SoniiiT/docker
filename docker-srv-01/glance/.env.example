# Variables defined here will be available to use anywhere in the config with the syntax ${MY_SECRET_TOKEN}
# Note: making changes to this file requires re-running docker compose up
MY_SECRET_TOKEN=123456

# Traefik Basic Auth - plain text credentials (same user as BASIC_AUTH_USERS)
TRAEFIK_USER=your-username
TRAEFIK_PASSWORD=your-password

# Portainer API Key - Generate in Portainer: Settings → API → API Keys
PORTAINER_API_KEY=your-api-key-here

# Jellyfin API Key - Generate in Jellyfin: Dashboard → API Keys
JELLYFIN_API_KEY=your-jellyfin-api-key

# Sonarr API Key - Sonarr: Settings → General → API Key
SONARR_API_KEY=your-sonarr-api-key

# Radarr API Key - Radarr: Settings → General → API Key
RADARR_API_KEY=your-radarr-api-key

# Jellyseerr API Key - Jellyseerr: Settings → General → API Key
JELLYSEERR_API_KEY=your-jellyseerr-api-key