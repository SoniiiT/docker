# Glance Built-in Auth
# 1) Generate a new secret:  docker run --rm glanceapp/glance secret:make
# 2) Generate password hash: docker run --rm glanceapp/glance password:hash yourpassword
GLANCE_SECRET=your-secret-key
GLANCE_PASSWORD_HASH=your-bcrypt-hash

# Proxmox VE API Token
# Erstellen unter: Proxmox → Datacenter → API Tokens
# Format: user@realm!tokenid=secret (z.B. root@pam!glance=abc123)
PROXMOX_API_TOKEN=user@realm!tokenid=your-token-secret

# n8n API Key
# Erstellen unter: n8n → Settings → n8n API → Create an API key
N8N_API_KEY=your-n8n-api-key

# WGDashboard API Key
# Erstellen unter: WGDashboard → Settings → API Key aktivieren + erstellen
WGD_API_KEY=your-wgdashboard-api-key

# Semaphore (Ansible) API Token
# Erstellen unter: Semaphore → User Icon → Your Profile → API Tokens → Add
SEMAPHORE_API_TOKEN=your-semaphore-api-token

# Speedtest Tracker - API Key: Settings → API Tokens
SPEEDTEST_API_KEY=your-speedtest-api-key

# Traefik Basic Auth - plain text credentials (same user as BASIC_AUTH_USERS)
TRAEFIK_USER=your-username
TRAEFIK_PASSWORD=your-password

# Portainer API Key - Generate in Portainer: Settings → API → API Keys
PORTAINER_API_KEY=your-api-key-here

# Jellyfin API Key - Generate in Jellyfin: Dashboard → API Keys
JELLYFIN_API_KEY=your-jellyfin-api-key

# Sonarr API Key - Sonarr: Settings → General → API Key
SONARR_API_KEY=your-sonarr-api-key

# Radarr API Key - Radarr: Settings → General → API Key
RADARR_API_KEY=your-radarr-api-key

# Jellyseerr API Key - Jellyseerr: Settings → General → API Key
JELLYSEERR_API_KEY=your-jellyseerr-api-key

# GitHub Personal Access Token - GitHub: Settings → Developer settings → Personal access tokens (classic)
# Required scopes: repo (read-only) or just public_repo for public repos
GITHUB_TOKEN=your-github-pat

# Wallos - Subscription Tracker
# WALLOS_URL: URL to your Wallos instance (no trailing slash), e.g. http://192.168.178.x:8282
# WALLOS_API_KEY: Profile → API Key in Wallos
WALLOS_URL=http://your-wallos-instance:8282
WALLOS_API_KEY=your-wallos-api-key

# Cloudflare API - for Cloudflare Tunnels widget
# Create token at: dash.cloudflare.com → My Profile → API Tokens
# Required permissions: Account → Cloudflare Tunnel → Read
# Account ID: dash.cloudflare.com → right sidebar
# Tunnel ID: Zero Trust → Networks → Tunnels → click tunnel → copy ID
CLOUDFLARE_ACCOUNT_ID=your-account-id
CLOUDFLARE_TUNNEL_ID=your-tunnel-id
CLOUDFLARE_API_KEY=your-api-token
# Zone ID: dash.cloudflare.com → domain auswählen → rechte Seitenleiste
CLOUDFLARE_ZONE_ID=your-zone-id