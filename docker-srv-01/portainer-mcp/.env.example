# Portainer URL reachable from the MCP container.
PORTAINER_URL=https://portainer.home.soniiit.net

# Generate a value locally and keep it only in this stack's .env file.
PORTAINER_MCP_AUTH_TOKEN=

# Exact Traefik peer IP or CIDR on traefik_proxy; do not use an unverified subnet.
PORTAINER_MCP_FORWARDED_ALLOW_IPS=
